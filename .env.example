# Used by docker-compose.yml. Copy to .env (git-ignored) and fill in.

# Required: secret for signing login tokens. Generate one with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# Host port for the web app (http://localhost:8080 by default).
WEB_PORT=8080

# Seed the 4 demo users/items on first start when the database is empty. Set false to skip.
SEED_DEMO=true
