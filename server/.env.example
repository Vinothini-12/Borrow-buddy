# Must point at the dedicated "borrowbuddy" database. db:migrate / db:reset refuse any other name.
DATABASE_URL=postgres://borrowbuddy:borrowbuddy@localhost:5433/borrowbuddy
# Use a long random string in any shared environment.
JWT_SECRET=change-me-to-a-long-random-string
PORT=5050
# Frontend origin allowed by CORS.
CLIENT_URL=http://localhost:5173
# Set to true for hosted Postgres that requires SSL.
DB_SSL=false
